<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Lending policy defaults.

        These are set from **Loans > Configuration > Settings**, which writes
        exactly these keys. They are seeded here so a fresh install has the
        two rules that were always on, and so the settings screen opens with
        values rather than blanks.

        `noupdate="1"` means an upgrade never overwrites a figure somebody set.

        The rules NOT seeded here — maximum concurrent loans, settle before
        reborrowing, cooling-off, ceiling-includes-debt, maximum repayment
        percentage — are deliberately absent, which reads as off. A policy that
        switched itself on during an upgrade would start refusing applications
        that were fine the day before, and nobody would connect the two.

        The loanable ceiling is not here at all: its bands are records, in
        data/loan_tiers.xml, because how many bands you run is itself a policy
        choice and does not fit in one field.
    -->
    <data noupdate="1">

        <!-- Continuous service required before anyone may borrow. -->
        <record id="param_loan_min_service_years" model="ir.config_parameter">
            <field name="key">nihao_hr_loan.min_service_years</field>
            <field name="value">1.0</field>
        </record>

        <!-- The standard weekly instalment offered on a new application. -->
        <record id="param_loan_weekly_repayment" model="ir.config_parameter">
            <field name="key">nihao_hr_loan.weekly_repayment</field>
            <field name="value">1000.0</field>
        </record>

        <!-- Days between approval and the first deduction. -->
        <record id="param_loan_start_delay_days" model="ir.config_parameter">
            <field name="key">nihao_hr_loan.repayment_start_delay_days</field>
            <field name="value">14</field>
        </record>

    </data>
</odoo>
