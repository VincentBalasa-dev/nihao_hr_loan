<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loan_reject_wizard_form" model="ir.ui.view">
        <field name="name">efs.loan.reject.wizard.form</field>
        <field name="model">efs.loan.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Loan Application">
                <group>
                    <field name="loan_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="borrower_name"/>
                    <field name="amount"/>
                </group>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="Why the application is refused. The employee is told this."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
