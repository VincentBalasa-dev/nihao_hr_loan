<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loan_repayment_rule_list" model="ir.ui.view">
        <field name="name">efs.loan.repayment.rule.list</field>
        <field name="model">efs.loan.repayment.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_loan_repayment_rule_form" model="ir.ui.view">
        <field name="name">efs.loan.repayment.rule.form</field>
        <field name="model">efs.loan.repayment.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="name"/>
                        <field name="note" placeholder="What this rule does, for the next person."/>
                    </group>
                    <notebook>
                        <page string="Python Code" name="code">
                            <field name="amount_python_compute" widget="ace"
                                   options="{'mode': 'python'}"/>
                            <p class="text-muted">
                                Assign the figure this payslip deducts to <code>result</code>.
                                Available: <code>result</code> (pre-filled with the built-in figure),
                                <code>per</code>, <code>balance</code>, <code>paid</code>,
                                <code>loans</code>, <code>employee</code>,
                                <code>date_from</code>, <code>date_to</code>,
                                <code>covers_15th</code>, <code>covers_month_end</code>,
                                <code>date</code>, <code>timedelta</code>, <code>monthrange</code>.
                                The figure is split equally across the loans on this rule; the
                                pay-availability cap and whole-instalment floor still apply.
                                A rule that raises is logged and the built-in figure is used.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loan_repayment_rules" model="ir.actions.act_window">
        <field name="name">Repayment Rules</field>
        <field name="res_model">efs.loan.repayment.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a repayment rule</p>
            <p>
                Salary-rule-style Python deciding what each payslip deducts.
                An application picks one of these; loans sharing a rule
                share its instalment.
            </p>
        </field>
    </record>

    <menuitem id="menu_loan_repayment_rules"
              name="Repayment Rules"
              parent="menu_loan_config"
              action="action_loan_repayment_rules"
              groups="hr.group_hr_manager"
              sequence="25"/>

</odoo>
