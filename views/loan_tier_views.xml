<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loan_eligibility_tier_list" model="ir.ui.view">
        <field name="name">efs.loan.eligibility.tier.list</field>
        <field name="model">efs.loan.eligibility.tier</field>
        <field name="arch" type="xml">
            <list string="Eligibility Bands" editable="bottom">
                <field name="min_service_years"/>
                <field name="salary_multiple"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_loan_eligibility_tier_form" model="ir.ui.view">
        <field name="name">efs.loan.eligibility.tier.form</field>
        <field name="model">efs.loan.eligibility.tier</field>
        <field name="arch" type="xml">
            <form string="Eligibility Band">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="min_service_years"/>
                        <field name="salary_multiple"/>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="text-muted">
                        Bands are floors. The multiple that applies is the one
                        belonging to the highest band whose threshold the
                        employee has reached, so someone at two and a half
                        years stays on the one-year band. Below the lowest band
                        nobody may borrow.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loan_eligibility_tier" model="ir.actions.act_window">
        <field name="name">Eligibility Bands</field>
        <field name="res_model">efs.loan.eligibility.tier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the loanable ceiling</p>
            <p>
                A band says: from this many years of service, an employee may
                borrow this multiple of their monthly basic salary.
                <br/>
                With no bands at all, nobody may borrow — a ceiling that fails
                open is not a ceiling.
            </p>
        </field>
    </record>

</odoo>
